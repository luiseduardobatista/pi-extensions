{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Extensões Pi do luiseduardobatista — monorepo de pacotes pequenos, independentes e modulares.",
  "pi": {
    "extensions": [
      "./packages/pi-header/index.ts",
      "./packages/pi-footer/index.ts",
      "./packages/pi-tool-renderers/index.ts",
      "./packages/pi-diff/index.ts",
      "./packages/pi-todo/index.ts",
      "./packages/pi-questionnaire/index.ts",
      "./packages/pi-btw/index.ts",
      "./packages/pi-lsp/index.ts",
      "./packages/pi-worktree/index.ts",
      "./packages/pi-effort/index.ts"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.base.json",
    "test": "node --test \"packages/*/*.test.ts\""
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^22.19.19",
    "typebox": "^1.3.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
